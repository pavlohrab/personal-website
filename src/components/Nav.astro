---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: `${import.meta.env.BASE_URL}` },
	{ label: 'Tools', href: `${import.meta.env.BASE_URL}tools/` },
	{ label: 'Projects', href: `${import.meta.env.BASE_URL}projects/` },
	{ label: 'CV', href: `${import.meta.env.BASE_URL}cv/` },
	{ label: 'Publications', href: `${import.meta.env.BASE_URL}publications/` },
	{ label: 'Talks & Teaching', href: `${import.meta.env.BASE_URL}outreach/` },
	{ label: 'Beyond', href: `${import.meta.env.BASE_URL}beyond/` },
	{ label: 'Contact', href: `${import.meta.env.BASE_URL}contact/` },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav data-pagefind-ignore>
	<div class="menu-header">
		<a href={import.meta.env.BASE_URL} class="site-title">
			<span>Pavlo Hrab</span>
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<button type="button" class="search-trigger" aria-label="Search" aria-keyshortcuts="Meta+K Control+K">
				<span class="search-trigger-icon"><Icon icon="search" /></span>
				<span class="search-trigger-label">Search</span>
				<kbd class="search-trigger-kbd">⌘K</kbd>
			</button>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);

		// Open the search overlay when the nav "Search" control is clicked.
		// Delegated on document so it survives View Transition swaps.
		document.addEventListener('click', (e) => {
			if ((e.target as Element).closest('.search-trigger')) {
				document.dispatchEvent(new CustomEvent('open-search'));
			}
		});
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3.5rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: block;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
	}

	/* The same sweep the nav links get from the global `a` rule, but drawn on
	   the inner span: the anchor is a flex item of .menu-header, so its display
	   is blockified and box-decoration-break can never fragment it. The span is
	   inline, so each line of the wordmark gets its own underline when it wraps
	   to two lines at narrow desktop widths. */
	.site-title span {
		background-image: linear-gradient(currentColor, currentColor);
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 2px;
		transition: background-size var(--sweep);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	.site-title:hover span,
	.site-title:focus-visible span {
		background-size: 100% 2px;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 0;
		border-radius: var(--radius-pill);
		padding: 0.5rem;
		font-size: 1.5rem;
		color: var(--gray-300);
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		box-shadow: var(--shadow-md);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		background:
			linear-gradient(180deg, var(--gray-600), transparent),
			radial-gradient(var(--gray-900), var(--gray-800) 150%);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--gradient-stroke);
		border-radius: var(--radius-pill);
		z-index: -1;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
	}

	.link[aria-current] {
		color: var(--gray-0);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--gray-999);
		border-radius: 0 0 0.75rem 0.75rem;
		box-shadow: var(--shadow-lg);
	}

	/* Labeled "Search" pill — its own distinct affordance on the right, matching
	   the nav-pill treatment (gradient fill + stroke ring + shadow). */
	.search-trigger {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.75rem;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		color: var(--gray-300);
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		border: 0;
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-md);
		cursor: pointer;
		transition:
			color var(--theme-transition),
			transform var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	.search-trigger::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--gradient-stroke);
		border-radius: var(--radius-pill);
		z-index: -1;
	}

	.search-trigger:hover,
	.search-trigger:focus-visible {
		color: var(--gray-0);
		transform: translateY(var(--lift));
		box-shadow: var(--shadow-lg);
	}

	.search-trigger-icon {
		display: flex;
		font-size: 1rem;
	}

	.search-trigger-kbd {
		font-family: var(--font-brand);
		font-size: var(--text-xs);
		color: var(--gray-400);
		padding: 0.05em 0.4em;
		border: 1px solid var(--gray-800);
		border-radius: var(--radius-tag);
	}

	/* The keyboard hint is meaningless on touch. */
	@media (max-width: 50em) {
		.search-trigger-kbd {
			display: none;
		}
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			/* Side columns hug their content; the centre nav pill takes the rest
			   and is allowed to shrink (minmax floor of 0) so it wraps to two
			   rows instead of shoving the right-hand cluster off-screen. */
			grid-template-columns: auto minmax(0, 1fr) auto;
			align-items: center;
			padding: 2.5rem clamp(1.5rem, 4vw, 5rem);
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-lg);
		}

		.menu-content {
			display: contents;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
			/* Stay content-width and centred at wide viewports; when the centre
			   column can no longer hold every link on one line, wrap within it. */
			justify-self: center;
			max-width: 100%;
			font-size: var(--text-sm);
			border-radius: var(--radius-pill);
			border: 0;
			padding: 0.5rem 0.5625rem;
			background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
			box-shadow: var(--shadow-md);
		}

		.nav-items::before {
			position: absolute;
			inset: -1px;
			content: '';
			background: var(--gradient-stroke);
			border-radius: var(--radius-pill);
			z-index: -1;
		}

		.link {
			padding: 0.5rem 1rem;
			border-radius: var(--radius-pill);
			/* Anchor the sweep to the text, not the padding box, or it floats
			   below the label and overhangs it on both sides. */
			background-origin: content-box;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition),
				background-size var(--sweep);
		}

		/* Hover is the sweep underline (see global.css) — no background pill,
		   or the two affordances fight. The pill is reserved for "you are here". */
		.link:hover,
		.link:focus {
			color: var(--gray-100);
		}

		.link[aria-current='page'] {
			color: var(--accent-text-over);
			background-color: var(--accent-regular);
		}

		/* The current page is already marked by the pill; it needs no underline. */
		.link[aria-current='page'] {
			background-image: none;
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}
	}

	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>
