---
import Icon from './Icon.astro';
---

<theme-toggle>
	<button>
		<span class="sr-only">Dark theme</span>
		<span class="icon light"><Icon icon="sun" /></span>
		<span class="icon dark"><Icon icon="moon-stars" /></span>
	</button>
</theme-toggle>

<style>
	/* Two cells, one sliding indicator. The indicator is --surface on a
	   --gray-800 track: a theme switch is a utility, and a green fill is
	   not spent on a utility. */
	button {
		display: flex;
		border: 0;
		border-radius: var(--radius-pill);
		padding: 0;
		background-color: var(--gray-800);
		cursor: pointer;
	}

	.icon {
		z-index: 1;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.3125rem;
		width: 1.375rem;
		height: 1.375rem;
		font-size: 0.8125rem;
		color: var(--gray-400);
		box-sizing: content-box;
	}

	.icon.light::before {
		content: '';
		z-index: -1;
		position: absolute;
		inset: 0;
		background-color: var(--surface);
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-sm);
	}

	:global(.theme-dark) .icon.light::before {
		transform: translateX(100%);
	}

	/* Whichever cell the indicator is under reads as ink; the other stays
	   muted, so the current theme is legible without colour alone. */
	:global(html:not(.theme-dark)) .icon.light,
	:global(.theme-dark) .icon.dark {
		color: var(--gray-0);
	}

	@media (prefers-reduced-motion: no-preference) {
		.icon,
		.icon.light::before {
			transition:
				transform var(--theme-transition),
				color var(--theme-transition);
		}
	}

	/* Below 50em the slider becomes a single 44px button showing the state
	   it will switch TO — there is no room for two cells beside a wordmark,
	   a search icon and a menu button. */
	@media (max-width: 50em) {
		button {
			width: 44px;
			height: 44px;
			align-items: center;
			justify-content: center;
			background: none;
		}

		.icon {
			width: 1.375rem;
			height: 1.375rem;
			padding: 0;
			font-size: 1.125rem;
			color: var(--gray-400);
		}

		.icon.light::before {
			display: none;
		}

		:global(html:not(.theme-dark)) .icon.light,
		:global(.theme-dark) .icon.dark {
			display: none;
		}
	}

	@media (forced-colors: active) {
		.icon.light::before {
			background-color: SelectedItem;
		}
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		constructor() {
			super();

			const button = this.querySelector('button')!;

			/** Set the theme to dark/light mode. */
			const setTheme = (dark: boolean) => {
				document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
				button.setAttribute('aria-pressed', String(dark));
				// Save preference to localStorage
				if (typeof localStorage !== 'undefined') {
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				}
			};

			// Toggle the theme when a user clicks the button.
			button.addEventListener('click', () => setTheme(!this.isDark()));

			// Initialize button state to reflect current theme (don't modify DOM).
			button.setAttribute('aria-pressed', String(this.isDark()));
		}

		isDark() {
			return document.documentElement.classList.contains('theme-dark');
		}
	}
	customElements.define('theme-toggle', ThemeToggle);
</script>
