---
import Icon from './Icon.astro';
import { socialLinks } from '../socialLinks';

const currentYear = new Date().getFullYear();
---

<footer data-pagefind-ignore>
	<p>&copy; {currentYear} Pavlo Hrab. All rights reserved.</p>
	<div class="socials">
		{
			socialLinks.map(({ href, icon, label }) => (
				<a href={href} class="social" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">{label}</span>
					<Icon icon={icon} />
				</a>
			))
		}
	</div>
	<p class="footer-contact"><a href={`${import.meta.env.BASE_URL}contact/`}>Get in Touch</a></p>
</footer>
<style>
	footer {
		margin-top: auto;
		padding: 2.5rem 2rem;
		text-align: center;
		color: var(--gray-400);
		font-size: var(--text-sm);
		border-top: 1px solid var(--gray-800);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	footer p {
		margin: 0;
	}

	.footer-contact a {
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
		transition:
			color var(--theme-transition),
			background-size var(--sweep);
	}

	.footer-contact a:hover {
		color: var(--accent-dark);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.625rem;
		font-size: var(--text-xl);
	}

	/* Muted at rest, full strength on hover — same direction as every other
	   hover on the site. Do NOT use --accent-text-over here: it is the colour
	   for text ON an accent fill and resolves to the page background. */
	.social {
		display: flex;
		padding: 0.375rem;
		text-decoration: none;
		color: var(--gray-400);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--gray-0);
	}

	.claude-credit {
		font-size: var(--text-xs);
		color: var(--gray-500);
		opacity: 0.6;
	}

	@media (min-width: 50em) {
		footer {
			padding: 2.5rem 5rem;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			gap: 3rem;
		}

		.footer-contact {
			position: relative;
			right: auto;
			margin-right: 6rem;
		}

		.claude-credit {
			margin-left: auto;
		}
	}
</style>
