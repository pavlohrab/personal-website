---
/**
 * ProjectCard Component
 * Reusable card for displaying project information
 * Can be used as a standalone card or as a clickable link
 *
 * Deliberately spare: title, dates, description, links.
 * No status chip — the date range already says whether it is ongoing.
 * No tag pills — they restated the description and nothing could be
 * clicked or filtered by them. `tags` is still accepted so content and
 * any future filtering UI keep working; it just isn't rendered as chrome.
 */

interface Props {
	title: string;
	status: 'ongoing' | 'complete' | 'released';
	meta: string;
	description: string;
	tags: string[];
	focus?: string;
	source?: string;
	stack?: string;
	output?: string;
	links?: Array<{ label: string; href: string }>;
	href?: string; // If provided, makes the entire card clickable
	featured?: boolean;
	compact?: boolean;
}

const {
	title,
	meta,
	description,
	focus,
	source,
	stack,
	output,
	links,
	href,
	featured = false,
	compact = false
} = Astro.props;

/** Provenance rows, in fixed order; a project may supply any subset. */
const provenance = ([
	['focus', focus],
	['source', source],
	['stack', stack],
	['output', output],
] as const).filter(([, value]) => Boolean(value));

// If href is provided, wrap in link, otherwise use article
const isClickable = !!href;
---

{isClickable ? (
	<a href={href} class="project-card-link">
		<article class:list={['project-card', { featured, compact }]}>
			<div class="project-header">
				<h3 class="project-title" set:html={title} />
			</div>
			<p class="project-meta">{meta}</p>
			<p class="project-description" set:html={description} />
			{provenance.length > 0 && (
				<dl class="provenance">
					{provenance.map(([key, value]) => (
						<>
							<dt>{key}</dt>
							<dd set:html={value} />
						</>
					))}
				</dl>
			)}
			<span class="read-more">Read more</span>
		</article>
	</a>
) : (
	<article class:list={['project-card', { featured, compact }]}>
		<div class="project-header">
			<h3 class="project-title" set:html={title} />
		</div>
		<p class="project-meta">{meta}</p>
		<p class="project-description" set:html={description} />
		{provenance.length > 0 && (
			<dl class="provenance">
				{provenance.map(([key, value]) => (
					<>
						<dt>{key}</dt>
						<dd set:html={value} />
					</>
				))}
			</dl>
		)}
		{links && links.length > 0 && (
			<div class="project-links">
				{links.map(link => (
					<a href={link.href} class="btn btn-outline btn-sm">{link.label}</a>
				))}
			</div>
		)}
	</article>
)}

<style>
	/* A sample-label strip, not prose: two mono columns, key and value.
	   The facts were already in the description; this makes them scannable. */
	.provenance {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.3rem 1rem;
		font-family: var(--font-data);
		font-size: var(--text-xs);
		line-height: 1.5;
		margin: 0 0 1.25rem;
	}

	.provenance dt {
		color: var(--gray-400);
	}

	.provenance dd {
		color: var(--gray-100);
		margin: 0;
		overflow-wrap: anywhere;
	}
</style>
